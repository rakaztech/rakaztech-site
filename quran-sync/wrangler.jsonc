{
  "name": "quran-heart-sync",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  // Branch previews (npx wrangler preview) need this block; empty = previews get no bindings,
  // so a preview never touches the real saved progress.
  "previews": {},
  "durable_objects": { "bindings": [{ "name": "VAULT", "class_name": "Vault" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Vault"] }]
}
